{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blend.local/schemas/config-v1.json",
  "title": "Blend project configuration",
  "type": "object",
  "required": ["schema", "id", "blender", "entrypoint", "brief", "project", "profiles"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "blender": {
      "type": "object",
      "required": ["minimumVersion", "factoryStartup", "offline"],
      "additionalProperties": false,
      "properties": {
        "minimumVersion": {"type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"},
        "maximumVersionExclusive": {"type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"},
        "executable": {"type": "string"},
        "factoryStartup": {"type": "boolean"},
        "offline": {"type": "boolean"},
        "allowAddons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "entrypoint": {"type": "string", "minLength": 1},
    "brief": {"type": "string", "minLength": 1},
    "blendSource": {
      "type": "object",
      "required": ["path", "checksum"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "project": {
      "type": "object",
      "required": ["frameRate", "frameStart", "frameEnd", "seed", "colorManagement"],
      "additionalProperties": false,
      "properties": {
        "frameRate": {"type": "number", "exclusiveMinimum": 0},
        "frameStart": {"type": "integer"},
        "frameEnd": {"type": "integer"},
        "seed": {"type": "integer"},
        "units": {"enum": ["NONE", "METRIC", "IMPERIAL"]},
        "unitScale": {"type": "number", "exclusiveMinimum": 0},
        "heroObjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "colorManagement": {
          "type": "object",
          "required": ["display", "view"],
          "additionalProperties": false,
          "properties": {
            "display": {"type": "string"},
            "view": {"type": "string"},
            "look": {"type": "string"},
            "exposure": {"type": "number"},
            "gamma": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "views": {
      "type": "array",
      "items": {"$ref": "#/$defs/view"}
    },
    "previewFrames": {
      "type": "array",
      "items": {"type": "integer"},
      "uniqueItems": true
    },
    "previewModes": {
      "type": "array",
      "items": {"enum": ["material", "clay", "depth", "normal", "object-index", "wireframe", "alpha"]},
      "uniqueItems": true
    },
    "variants": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/variant"}
    },
    "matrices": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/matrix"}
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/output"}
    },
    "exports": {
      "type": "array",
      "items": {"$ref": "#/$defs/export"}
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "catalogs": {
      "type": "array",
      "items": {"$ref": "#/$defs/catalogRef"}
    },
    "libraries": {
      "type": "array",
      "items": {"$ref": "#/$defs/libraryRef"}
    },
    "simulations": {
      "type": "array",
      "items": {"$ref": "#/$defs/simulation"}
    },
    "simulationProfiles": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/simulationProfile"}
    },
    "policies": {"$ref": "#/$defs/policies"},
    "resources": {"$ref": "#/$defs/resources"},
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assets": {"type": "string"},
        "working": {"type": "string"},
        "cache": {"type": "string"},
        "artifacts": {"type": "string"},
        "outputs": {"type": "string"},
        "temporary": {"type": "string"}
      }
    },
    "searches": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/search"}
    },
    "environment": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "nondeterminism": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system", "reason"],
        "additionalProperties": false,
        "properties": {
          "system": {"type": "string"},
          "reason": {"type": "string"},
          "scope": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["engine", "width", "height", "samples", "format"],
      "additionalProperties": false,
      "properties": {
        "engine": {"enum": ["BLENDER_EEVEE_NEXT", "BLENDER_WORKBENCH", "CYCLES"]},
        "device": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "percentage": {"type": "integer", "minimum": 1, "maximum": 100},
        "samples": {"type": "integer", "minimum": 1},
        "denoise": {"type": "boolean"},
        "format": {"enum": ["PNG", "OPEN_EXR", "JPEG", "TIFF"]},
        "colorMode": {"enum": ["BW", "RGB", "RGBA"]},
        "transparent": {"type": "boolean"},
        "final": {"type": "boolean"},
        "timeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "simulationProfile": {"type": "string"},
        "limits": {"$ref": "#/$defs/resources"}
      }
    },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumCoverage": {"type": "number", "minimum": 0, "maximum": 1},
        "maximumCoverage": {"type": "number", "minimum": 0, "maximum": 1},
        "requireFullyVisible": {"type": "boolean"},
        "titleSafe": {"type": "number", "minimum": 0, "maximum": 0.49},
        "subjectSafe": {"type": "number", "minimum": 0, "maximum": 0.49}
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"required": ["camera"]},
        {"required": ["generated"]}
      ],
      "properties": {
        "id": {"type": "string"},
        "camera": {"type": "string"},
        "generated": {"enum": ["front", "rear", "left", "right", "side", "top", "bottom"]},
        "subjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "framing": {"$ref": "#/$defs/framing"}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "extends": {"type": "string"},
        "profile": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "camera": {"type": "string"},
        "text": {"type": ["string", "object"]},
        "language": {"type": "string"},
        "palette": {"type": ["string", "object", "array"]},
        "material": {"type": ["string", "object"]},
        "model": {"type": ["string", "object"]},
        "dataSource": {"type": "string"},
        "lighting": {"type": ["string", "object"]},
        "timing": {"type": "object"},
        "parameters": {"type": "object"}
      }
    },
    "matrix": {
      "type": "object",
      "required": ["variants"],
      "additionalProperties": false,
      "properties": {
        "variants": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "profiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "concurrency": {"type": "integer", "minimum": 1}
      }
    },
    "output": {
      "type": "object",
      "required": ["id", "type", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["video", "still", "sequence", "preview-video"]},
        "path": {"type": "string"},
        "variant": {"type": "string"},
        "frame": {"type": "integer"},
        "view": {"type": "string"},
        "mode": {"enum": ["material", "clay", "depth", "normal", "object-index", "wireframe", "alpha"]},
        "frameRate": {"type": "number", "exclusiveMinimum": 0},
        "profile": {"type": "string"},
        "codec": {"enum": ["h264", "hevc", "prores", "prores-alpha", "ffv1"]},
        "pixelFormat": {"type": "string"},
        "audio": {"type": "string"},
        "audioRequired": {"type": "boolean"},
        "colorMetadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primaries": {"type": "string"},
            "transfer": {"type": "string"},
            "space": {"type": "string"},
            "range": {"type": "string"}
          }
        },
        "fadeInSeconds": {"type": "number", "minimum": 0},
        "fadeOutSeconds": {"type": "number", "minimum": 0},
        "finalHoldSeconds": {"type": "number", "minimum": 0},
        "alpha": {"type": "boolean"}
      }
    },
    "export": {
      "type": "object",
      "required": ["id", "format", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "format": {"enum": ["glb", "gltf", "usd", "usdc", "usda", "fbx", "obj", "abc", "stl"]},
        "path": {"type": "string"},
        "profile": {"type": "string"},
        "variant": {"type": "string"},
        "includeCollections": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "includeObjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "units": {"type": "string"},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "forwardAxis": {"type": "string"},
        "upAxis": {"type": "string"},
        "applyTransforms": {"type": "boolean"},
        "applyModifiers": {"type": "boolean"},
        "triangulate": {"type": "boolean"},
        "materials": {"type": "boolean"},
        "packageTextures": {"type": "boolean"},
        "animations": {"type": "boolean"},
        "cameras": {"type": "boolean"},
        "lights": {"type": "boolean"},
        "includeHidden": {"type": "boolean"},
        "customProperties": {"type": "boolean"},
        "requireManifold": {"type": "boolean"},
        "limits": {"type": "object", "additionalProperties": {"type": "number"}},
        "optimize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decimateRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "weldDistance": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "oneOf": [
        {"required": ["path"]},
        {"required": ["catalog", "version"]}
      ],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["model", "texture", "font", "audio", "data", "cache", "reference", "other"]},
        "path": {"type": "string"},
        "catalog": {"type": "string"},
        "version": {"type": "string"},
        "checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "license": {"type": "string"},
        "fontLicenseMetadata": {"type": "string"},
        "units": {"type": "string"},
        "coordinateSystem": {"type": "string"},
        "colorSpace": {"type": "string"},
        "required": {"type": "boolean"},
        "allowUnpinnedPreview": {"type": "boolean"},
        "maximumTextureDimension": {"type": "integer", "minimum": 1}
      }
    },
    "catalogRef": {
      "type": "object",
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "path": {"type": "string"},
        "checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "libraryRef": {
      "type": "object",
      "required": ["id", "version", "path", "checksum"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "path": {"type": "string"},
        "checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "simulationProfile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "quality": {"enum": ["preview", "final"]},
        "substeps": {"type": "integer", "minimum": 1},
        "resolution": {"type": "integer", "minimum": 1},
        "timeScale": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "simulation": {
      "type": "object",
      "required": ["id", "type", "cacheRoot", "frameStart", "frameEnd", "dependencies", "deterministic"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["cloth", "fluid", "particles", "rigid-body", "geometry-nodes", "custom"]},
        "cacheRoot": {"type": "string"},
        "frameStart": {"type": "integer"},
        "frameEnd": {"type": "integer"},
        "seed": {"type": "integer"},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expectedFiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "deterministic": {"type": "boolean"},
        "previewProfile": {"type": "string"},
        "finalProfile": {"type": "string"},
        "maximumBytes": {"type": "integer", "minimum": 0}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promote": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "suppress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "reason", "scope"],
            "additionalProperties": false,
            "properties": {
              "rule": {"type": "string"},
              "reason": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "minLength": 1}
            }
          }
        },
        "requireAppliedScale": {"type": "boolean"},
        "requireClosedMeshes": {"type": "boolean"},
        "requireStableNames": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxProcesses": {"type": "integer", "minimum": 1},
        "maxGpuProcesses": {"type": "integer", "minimum": 1},
        "maxMemoryMB": {"type": "integer", "minimum": 1},
        "maxDiskBytes": {"type": "integer", "minimum": 1},
        "maxResolutionPixels": {"type": "integer", "minimum": 1},
        "maxSamples": {"type": "integer", "minimum": 1},
        "maxFrames": {"type": "integer", "minimum": 1},
        "maxTriangles": {"type": "integer", "minimum": 1},
        "maxObjects": {"type": "integer", "minimum": 1},
        "maxTextureBytes": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "thermalAdvisory": {"type": "boolean"}
      }
    },
    "search": {
      "type": "object",
      "required": ["baseVariant", "parameters", "budget", "scores"],
      "additionalProperties": false,
      "properties": {
        "baseVariant": {"type": "string"},
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "array", "minItems": 1}
        },
        "budget": {"type": "integer", "minimum": 1},
        "profile": {"type": "string"},
        "view": {"type": "string"},
        "scores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "metric", "direction"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "metric": {"enum": ["coverage", "triangleCount", "objectCount", "renderSeconds", "luminance", "alphaCoverage"]},
              "direction": {"enum": ["minimize", "maximize", "target"]},
              "target": {"type": "number"},
              "weight": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
