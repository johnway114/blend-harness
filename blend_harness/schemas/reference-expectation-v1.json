{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blend.local/schemas/reference-expectation-v1.json",
  "title": "Blend executable reference-project expectations",
  "type": "object",
  "required": ["schema", "project", "inspection", "validation", "outputs", "commands", "visualBaseline"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "project": {"type": "string"},
    "inspection": {
      "type": "object",
      "required": ["requiredObjects", "minimumObjects", "minimumTriangles", "requiredCameras"],
      "additionalProperties": false,
      "properties": {
        "requiredObjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "minimumObjects": {"type": "integer", "minimum": 0},
        "minimumTriangles": {"type": "integer", "minimum": 0},
        "requiredCameras": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "validation": {
      "type": "object",
      "required": ["profile", "variant", "passed", "requiredRuleIds"],
      "additionalProperties": false,
      "properties": {
        "profile": {"type": "string"},
        "variant": {"type": ["string", "null"]},
        "passed": {"type": "boolean"},
        "requiredRuleIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "commands": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "visualBaseline": {"type": "string"}
  }
}
